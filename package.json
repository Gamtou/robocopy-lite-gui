{
  "name": "robocopy-lite-gui",
  "version": "0.4.1",
  "private": true,
  "description": "Windows 持续同步和 Robocopy 备份任务面板",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check backup.js && node --check progress.js && node --check sync-engine.js && node --check tasks.js && node --check main.js && node --check preload.js && node --check renderer.js && node --check log-page.js",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.robocopy.lite",
    "productName": "Robocopy Lite",
    "artifactName": "Robocopy Lite ${version}.exe",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "backup.js",
      "progress.js",
      "sync-engine.js",
      "tasks.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "log-page.js",
      "index.html",
      "styles.css",
      "sync.ico",
      "sync.png",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "icon": "sync.ico",
      "target": "portable"
    }
  }
}
